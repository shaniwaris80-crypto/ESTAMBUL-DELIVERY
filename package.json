{
  "name": "estambul-delivery",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backoffice": "npm run dev -w @estambul/backoffice",
    "dev:rider": "npm run start -w @estambul/rider",
    "build:backoffice": "npm run build -w @estambul/backoffice",
    "typecheck:backoffice": "npm run typecheck -w @estambul/backoffice",
    "typecheck:rider": "npm run typecheck -w @estambul/rider",
    "check:demo": "node --check docs/demo.js && node --check docs/sw.js"
  },
  "engines": {
    "node": ">=20"
  }
}
