{
  "expo": {
    "name": "Estambul Delivery Rider",
    "slug": "estambul-delivery-rider",
    "scheme": "estambuldelivery",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.estambuldelivery.rider"
    },
    "android": {
      "package": "com.estambuldelivery.rider",
      "adaptiveIcon": {
        "backgroundColor": "#14253b"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
